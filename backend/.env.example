# PodcastGPT Configuration
PORT=5000
HOST=127.0.0.1
FLASK_DEBUG=True
FLASK_ENV=development
SECRET_KEY=podcastgpt-super-secret-key-change-in-production

# AI & LLM Providers
# Enter your Google Gemini API Key below to activate real-time LLM reasoning & summarization:
GOOGLE_API_KEY=your_gemini_api_key_here
DEFAULT_LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-1.5-flash

# Optional OpenAI Integration
OPENAI_API_KEY=

# Storage Paths
DATABASE_PATH=backend/data/podcastgpt.db
CHROMA_PERSIST_DIR=backend/data/chroma
